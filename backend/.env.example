# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-here-change-in-production-min-32-chars

# Database Configuration
DB_URL=jdbc:mysql://localhost:3306/medirecdb?useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
DB_USERNAME=root
DB_PASSWORD=your-database-password-here

# Encryption
ENCRYPTION_PASSWORD=your-encryption-password-here

# Server Configuration
SERVER_PORT=8081

# Google OAuth2
GOOGLE_CLIENT_ID=your-google-client-id-here
GOOGLE_CLIENT_SECRET=your-google-client-secret-here

# API URLs (for CORS and OAuth redirects)
APP_FRONTEND_URL=http://localhost:3000
BACKEND_BASE_URL=http://localhost:8081
